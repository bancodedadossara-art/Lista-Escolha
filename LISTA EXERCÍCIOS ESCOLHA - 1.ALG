Algoritmo "LISTA EXERCÍCIOS ESCOLHA - 1"

Var
dia: inteiro

Inicio
enquanto dia <> 8 faca
         escreval ("Escolha o dia da semana: ")
         leia (dia)
         escolha (dia)
         caso 1
              escreval ("Domingo")
         caso 2
              escreval ("Segunda-feira")
         caso 3
              escreval ("Terça-feira")
         caso 4
              escreval ("Quarta-feira")
         caso 5
              escreval ("Quinta-feira")
         caso 6
              escreval ("Sexta-feira")
         caso 7
              escreval ("Sábado")
         caso 8
              escreval ("Encerrando busca.")
         outrocaso
                  escreval ("Dia inválido. Insira um número de 1 a 7.")
         fimescolha
fimenquanto
Fimalgoritmo